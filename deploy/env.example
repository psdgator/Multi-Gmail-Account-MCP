# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Public host name that points (DNS A/AAAA record) to this server.
MCP_DOMAIN=mail-mcp.example.com

# Password you type once when connecting Claude to this server (12+ characters).
GMAIL_MCP_HTTP_PASSWORD=

# Encryption key for stored mail logins and tokens. Generate with:
#   openssl rand -base64 32
# Keep a copy somewhere safe: without it the stored logins can't be decrypted.
GMAIL_MCP_MASTER_KEY=

# readonly | drafts | full
GMAIL_MCP_MODE=drafts
