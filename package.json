{
  "name": "multi-gmail-account-mcp",
  "version": "0.3.0",
  "mcpName": "io.github.psdgator/multi-gmail-account-mcp",
  "description": "MCP server for many Gmail (and IMAP) accounts at once: search all inboxes together, needs-reply finder, daily digest, attachments, Calendar, safe drafts-only mode, hosted mode for claude.ai.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "multi-gmail-account-mcp": "dist/index.js",
    "gmail-mcp-multi": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "scripts/smoke.mjs",
    "README.md",
    "PRIVACY.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "auth": "node dist/index.js auth",
    "accounts": "node dist/index.js accounts",
    "test": "npm run build && vitest run",
    "prepare": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm test",
    "docs": "npm run build && node scripts/gen-tools-doc.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "gmail",
    "imap",
    "email",
    "multi-account",
    "google-calendar",
    "claude",
    "claude-desktop"
  ],
  "author": "Elle Morrill",
  "contributors": [
    "Antonis Papamichail <antony@psdgator.com>",
    "Dave Moudy",
    "Vadim Zaliva",
    "Bobby Marko"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/psdgator/Multi-Gmail-Account-MCP.git"
  },
  "dependencies": {
    "@googleapis/calendar": "^20.1.0",
    "@googleapis/gmail": "^22.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fflate": "^0.8.3",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1",
    "unpdf": "^1.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "hoodiecrow-imap": "^3.3.1",
    "pdf-lib": "^1.17.1",
    "smtp-server": "^3.21.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.2"
  },
  "homepage": "https://github.com/psdgator/Multi-Gmail-Account-MCP#readme",
  "bugs": {
    "url": "https://github.com/psdgator/Multi-Gmail-Account-MCP/issues"
  }
}
